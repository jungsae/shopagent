# shopagent Upstage env 예시 — 실키를 넣지 말 것.
# 사용 시: cp docs/upstage.env.example ~/.config/shopagent/upstage.env
# 그다음 값을 채우고 chmod 600. git에 실키 파일 커밋 금지.

UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=https://api.upstage.ai
UPSTAGE_DECIDE_MODEL=solar-decide
# Mix2 전용. 콘솔에서 model id·단가 확정 전까지 비워 둔다.
UPSTAGE_CHAT_MODEL=
